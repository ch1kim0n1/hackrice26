{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nutriquest.dev/schemas/battle-sim-unit.json",
  "title": "Battle Unit Spec (squad snapshot)",
  "description": "One locked monster entering a battle — the squad snapshot the engine consumes (BattleUnitSpec in backend/src/services/battleEngine.ts; mirrored by BattleKit). Stats are PRE-scaling bases: the engine applies rarity × star itself. There is no element, no four-stat blob, no fusionTier.",
  "type": "object",
  "required": ["id", "name", "baseHealth", "baseAttack", "rarity", "star", "moves"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "baseHealth": { "type": "number", "minimum": 1, "description": "Pre-scaling Health base." },
    "baseAttack": { "type": "number", "minimum": 0, "description": "Pre-scaling Base Attack." },
    "rarity": {
      "type": "string",
      "enum": ["common", "uncommon", "rare", "epic", "legendary", "mythic", "secret"],
      "description": "Instance rarity — rolled at mint, never intrinsic to the character."
    },
    "star": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Mastery star level, 1-based. Secret clamps to ★2 for combat scaling."
    },
    "baseMana": {
      "type": "number",
      "minimum": 0,
      "description": "Authored Mana pool; only Epic+ instances carry Mana."
    },
    "moves": {
      "type": "array",
      "minItems": 1,
      "description": "3 authored standard moves, plus the Mana Special for Epic+ instances.",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "power", "accuracy", "manaCost"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["standard", "special"] },
          "power": { "type": "number", "minimum": 0, "description": "0-10 scale; 0 = pure status/utility." },
          "accuracy": { "type": "number", "minimum": 0, "maximum": 100, "description": "P(hit) in percent." },
          "manaCost": { "type": "number", "minimum": 0 },
          "statusEffect": { "type": "string", "enum": ["burn", "acc_down", "atk_up", "guard_up", "stun", "heal", "leech"] },
          "statusChance": { "type": "number", "minimum": 0, "maximum": 100, "description": "P(status | hit) in percent." },
          "duration": { "type": "integer", "minimum": 1, "description": "Timed-status duration in the affected side's turns." },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

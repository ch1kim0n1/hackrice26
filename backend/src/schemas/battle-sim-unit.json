{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nutriquest.dev/schemas/battle-sim-unit.json",
  "title": "Battle Sim Unit",
  "description": "A character as seen by the battle simulation engine. Stats are rarity/fusion-scaled (see backend/src/routes/battle.ts:277-295 toSim). Mirrors BattleKit SimUnit.",
  "type": "object",
  "required": ["id", "name", "element", "power", "guard", "vitality", "tempo"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "element": {
      "type": "string",
      "enum": ["protein", "fiber", "vitamin", "hydration"]
    },
    "power": { "type": "number", "minimum": 0, "maximum": 1000 },
    "guard": { "type": "number", "minimum": 0, "maximum": 1000 },
    "vitality": { "type": "number", "minimum": 0, "maximum": 1000 },
    "tempo": { "type": "number", "minimum": 0, "maximum": 1000 },
    "fusionTier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "0-5. Boosts signature move power at >= 3 (×1.25)."
    }
  },
  "additionalProperties": false
}

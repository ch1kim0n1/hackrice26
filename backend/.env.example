# NutriQuest backend environment (see docs/SECURITY.md §Secrets).
# Copy to .env and fill in. NEVER commit real secrets.

# --- Server ---
PORT=4000
# NODE_ENV=production
# CORS_ORIGIN=https://your-frontend.example

# --- Local dev persistence (node:sqlite) ---
# Path to the SQLite file, or "memory" for an ephemeral in-memory db.
# On Railway, attach a persistent volume and point this at it.
NUTRIQUEST_DB=data/nutriquest.db

# --- TigerData (Tiger Cloud PostgreSQL + TimescaleDB) ---
# The relational/time-series store. Unset locally means the normalized mirrors
# are a no-op and the app runs on SQLite alone, which is what the test suite
# expects -- so leave it blank unless you are working on the Postgres side.
#
# Tiger Cloud requires TLS, so the string must carry ?sslmode=require. Injected
# server-side (Railway env); never committed, never in the iOS/Watch bundle.
DATABASE_URL=                  # postgres://USER:PASS@HOST:PORT/DB?sslmode=require
# PG_POOL_MAX=10               # bounded pool size; defaults to 10

# --- Game / anti-cheat secrets ---
SERVER_SECRET=                 # HMAC key for battle seeds + capsule open rolls
                               # (must match the DB app.server_secret GUC)

# --- Dish photo analysis (vision) ---
# Any OpenAI-compatible chat-completions endpoint. Defaults to OpenAI's
# gpt-4o-mini; without a key photo scanning returns 503 VISION_UNAVAILABLE.
VISION_API_URL=                # default https://api.openai.com/v1/chat/completions
VISION_MODEL=                  # default "gpt-4o-mini"
VISION_API_KEY=                # falls back to OPENAI_API_KEY when unset

# --- AI services (post-hackathon / feature flagged) ---
GROQ_API_KEY=                  # character lore
OPENAI_API_KEY=                # gym-photo Vision check; also the vision fallback key

# --- Persona identity verification (human-gate step 2) ---
# Server-side only — never in the web app or iOS bundle. When unset, the
# persona endpoints return 503 PERSONA_NOT_CONFIGURED and signup skips the
# verification step.
PERSONA_API_KEY=               # persona_sandbox_* / persona_production_*
PERSONA_TEMPLATE_ID=           # itmpl_* — Persona Dashboard → Inquiries → Templates
                               # (sandbox keys cannot list templates via API)
# PERSONA_API_URL=             # default https://api.withpersona.com

# --- Admin ---
# NUTRIQUEST_ADMIN_TOKEN=      # enables admin routes when set

# --- Human vs AI Persona demo (sandbox-only, isolated from real auth) ---
# All /demo/* routes 404 unless this is exactly "true". Reuses the Persona
# sandbox config above; without it, /demo falls back to a dev-only mock
# adapter (never used when PERSONA_API_KEY/PERSONA_TEMPLATE_ID are set, and
# disabled outright in production).
# ENABLE_PERSONA_DEMO=true
